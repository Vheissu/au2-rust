{
  "name": "au2-rust-web",
  "description": "Aurelia 2 frontend for au2-rust.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm -- --dev && vite",
    "build": "npm run wasm && npm run build:web",
    "build:web": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run wasm -- --dev && vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aurelia/fetch-client": "^2.0.0-rc.2",
    "aurelia": "^2.0.0-rc.2"
  },
  "devDependencies": {
    "@aurelia/platform-browser": "^2.0.0-rc.2",
    "@aurelia/runtime": "^2.0.0-rc.2",
    "@aurelia/testing": "^2.0.0-rc.2",
    "@aurelia/vite-plugin": "^2.0.0-rc.2",
    "@types/node": "^24.19.2",
    "jsdom": "^30.1.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
